        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="9"
            android:orientation="horizontal"
            android:weightSum="2"

            android:layout_below="@id/buttonCustomTest">
            <LinearLayout
                android:id="@+id/buttonConteudo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="9dp"
                android:layout_marginStart="18dp"
                android:paddingTop="20dp"
                android:paddingHorizontal="12dp"
                android:paddingBottom="27dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/purple_button">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.7"
                    android:src="@drawable/book_icon_simplified"
                    android:scaleType="fitCenter"
                    android:contentDescription="Config icon" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.3"
                    android:text="CONTEÚDO"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="12sp"
                    android:autoSizeMaxTextSize="24sp"
                    android:autoSizeStepGranularity="1sp"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/buttonConfigurations"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="18dp"
                android:layout_marginStart="9dp"

                android:paddingHorizontal="12dp"

                android:paddingTop="20dp"
                android:paddingBottom="27dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/orange_button">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.7"
                    android:src="@drawable/save_icon"
                    android:scaleType="fitCenter"
                    android:contentDescription="Config icon" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.3"
                    android:text="RESULTADOS"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="12sp"
                    android:autoSizeMaxTextSize="24sp"
                    android:autoSizeStepGranularity="1sp"/>

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>




