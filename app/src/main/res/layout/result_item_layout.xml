<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="4dp"
    android:paddingBottom="12dp"
    android:paddingHorizontal="18dp"
    android:background="@drawable/green_border_back">

    <ImageView
        android:id="@+id/user_icon"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:src="@drawable/user_icon"
        android:layout_marginTop="12dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"/>

    <TextView
        android:id="@+id/nameTV"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:paddingHorizontal="4dp"
        android:text="Teste"
        android:textAlignment="textStart"
        android:textStyle="bold"
        android:layout_marginStart="2dp"
        android:layout_marginVertical="12dp"
        android:layout_marginEnd="6dp"

        android:gravity="center"

        android:textColor="@color/white"
        android:maxLines="1"
        android:ellipsize="end"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeMaxTextSize="34sp"
        android:autoSizeStepGranularity="1sp"

        android:layout_toStartOf="@id/dateTV"
        android:layout_toEndOf="@id/user_icon"/>

    <TextView
        android:id="@+id/dateTV"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="18dp"

        android:autoSizeMaxTextSize="34sp"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="00:00 00/00"
        android:gravity="center"

        android:textAlignment="textEnd"
        android:textColor="@color/white"
        android:textStyle="bold" />

    <View
        android:id="@+id/line1"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#ffffff"
        android:layout_marginTop="2dp"
        android:layout_marginHorizontal="6dp"
        android:layout_below="@id/user_icon"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentLine1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/line1">

        <ImageView
            android:id="@+id/numCases_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/num_cases_icon"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@id/divisor1"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/numCasesTV"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"

            android:autoSizeMaxTextSize="34sp"
            android:autoSizeMinTextSize="17sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"

            android:text="999 casos"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/numCases_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/divisor1"
            android:layout_width="3dp"
            android:layout_height="24dp"

            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:background="#FFFFFF" />

        <ImageView
            android:id="@+id/acertos_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="2dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/acertos_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/divisor1"/>

        <TextView
            android:id="@+id/acertosTV"
            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_marginStart="4dp"


            android:layout_toStartOf="@id/acertos_icon"
            android:layout_toEndOf="@+id/divisor1"
            android:autoSizeMaxTextSize="34sp"
            android:autoSizeMinTextSize="17sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"

            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="999 acertos"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/acertos_icon"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>






    <View
        android:id="@+id/line2"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#ffffff"
        android:layout_marginTop="2dp"
        android:layout_marginHorizontal="6dp"
        android:layout_below="@id/contentLine1"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentLine2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/line2">

    <ImageView
        android:id="@+id/maxTime_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/clock_icon"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@id/divisor2"
        app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/maxTimeTV"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"

            android:autoSizeMaxTextSize="34sp"
            android:autoSizeMinTextSize="17sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"

            android:text="99:99:99"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/maxTime_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/divisor2"
        android:layout_width="3dp"
        android:layout_height="24dp"

        android:layout_marginStart="8dp"
        android:layout_marginTop="2dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="#FFFFFF" />

    <ImageView
        android:id="@+id/timeRemaining_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="2dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/time_remaining_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/divisor2"/>

        <TextView
            android:id="@+id/timeRemainingTV"
            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_marginStart="4dp"


            android:layout_toStartOf="@id/timeRemaining_icon"
            android:layout_toEndOf="@+id/divisor2"
            android:autoSizeMaxTextSize="34sp"
            android:autoSizeMinTextSize="17sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"

            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="99:99:99"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/timeRemaining_icon"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <TextView
        android:id="@+id/taxaPorcentagemTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/contentLine2"
        android:drawableEnd="@drawable/porcentagem_icon"
        android:background="@drawable/white_border"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:drawablePadding="2dp"
        android:text="100"
        android:layout_marginTop="4dp"
        android:layout_centerHorizontal="true"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="24sp"/>



</RelativeLayout>