<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <ImageButton
        android:id="@+id/bottom_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"

        android:layout_gravity="center|center_vertical"
        android:layout_centerHorizontal="true"
        android:background="@drawable/bottom_drag_button" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="50dp"
        android:paddingVertical="20dp"
        android:background="@drawable/white_card"
        android:textColor="@color/black"
        android:layout_below="@id/bottom_button"
        android:textSize="28sp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SELECIONE O ESTÁGIO DA CÁRIE:"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginHorizontal="20dp"/>



        <RelativeLayout
            android:id="@+id/groupButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/inside_card"
            android:elevation="10dp"
            android:paddingVertical="20dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginVertical="10dp"
            android:layout_below="@+id/title">

            <LinearLayout
                android:id="@+id/buttonsLayer1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/level1Button"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:background="@drawable/unselected_button"
                    android:gravity="center"
                    android:text="1"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_marginVertical="5dp"
                    android:layout_marginStart="16dp"
                    android:textColor="@color/white"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/level2Button"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:background="@drawable/unselected_button"
                    android:gravity="center"
                    android:text="2"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_marginVertical="5dp"
                    android:layout_marginHorizontal="12dp"
                    android:textColor="@color/white"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/level3Button"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:background="@drawable/unselected_button"
                    android:gravity="center"
                    android:text="3"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_marginVertical="5dp"
                    android:layout_marginEnd="16dp"
                    android:textColor="@color/white"
                    android:layout_weight="1"/>



            </LinearLayout>

            <LinearLayout
                android:id="@+id/buttonsLayer2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_below="@+id/buttonsLayer1">

                <TextView
                    android:id="@+id/level4Button"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:background="@drawable/unselected_button"
                    android:gravity="center"
                    android:text="4"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_marginVertical="5dp"
                    android:layout_marginStart="16dp"
                    android:textColor="@color/white"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/level5Button"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:background="@drawable/unselected_button"
                    android:gravity="center"
                    android:text="5"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_marginVertical="5dp"
                    android:layout_marginHorizontal="12dp"
                    android:textColor="@color/white"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/level6Button"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:background="@drawable/unselected_button"
                    android:gravity="center"
                    android:text="6"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_marginVertical="5dp"
                    android:layout_marginEnd="16dp"
                    android:textColor="@color/white"
                    android:layout_weight="1"/>



            </LinearLayout>

            <TextView
                android:id="@+id/carieFreeButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_below="@id/buttonsLayer2"
                android:background="@drawable/selected_button"
                android:gravity="center"
                android:text="HÍGIDO"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="5dp"
                android:layout_marginHorizontal="16dp"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold"/>



        </RelativeLayout>

        <TextView
            android:id="@+id/confirmButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/confirm_button"
            android:text="CONFIRMAR"
            android:textSize="24sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:paddingVertical="18dp"
            android:layout_marginVertical="12dp"
            android:layout_marginHorizontal="24dp"
            android:textStyle="bold"
            android:layout_below="@id/groupButtons"/>




    </RelativeLayout>



</RelativeLayout>