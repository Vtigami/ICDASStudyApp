<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/back_default"
    android:weightSum="20"
    tools:context=".CreateCustomTestActivity">



    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2">

        <ImageView
            android:id="@+id/returnButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginVertical="6dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/return_button"
            android:padding="12dp"
            android:src="@drawable/return_icon"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintHeight_max="64dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="17"
        android:paddingBottom="18dp"
        android:layout_marginHorizontal="8dp"
        android:orientation="vertical"
        android:weightSum="17">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:background="@drawable/darker_transparent_back_border"
        android:orientation="vertical"
        android:layout_marginVertical="12dp"
        android:layout_marginHorizontal="12dp"
        android:padding="12dp"
        android:weightSum="2">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="Nome da Configuração"
            android:textColor="@color/white"
            android:gravity="bottom|start"
            android:textStyle="bold"
            android:layout_marginEnd="20dp"
            android:maxLines="1"
            android:paddingVertical="6dp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="30sp"
            android:autoSizeStepGranularity="1sp"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">


        <EditText
            android:id="@+id/nameET"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/edit_text_back"
            android:hint="Insira o nome da configuração"
            android:textColor="@color/black"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:layout_marginVertical="12dp"
            android:elevation="5dp"
            android:maxLines="1"
            android:textColorHint="#7A7A7A"


            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHeight_max="80dp"

            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="20sp"
            android:autoSizeStepGranularity="1sp"
            />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="8"
        android:orientation="horizontal"
        android:layout_marginVertical="12dp"
        android:weightSum="2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/darker_transparent_back_border"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="4dp"
            android:padding="12dp"
            android:weightSum="12">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="4"
                android:text="Número de Casos:"
                android:textColor="@color/white"
                android:textAlignment="textStart"
                android:textStyle="bold"
                android:maxLines="2"
                android:paddingVertical="4dp"
                android:layout_marginHorizontal="8dp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="60sp"
                android:autoSizeStepGranularity="1sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="6"
                android:orientation="horizontal"
                android:weightSum="10">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/numCasesET"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="7"
                    android:layout_marginVertical="8dp"

                    android:layout_gravity="center_vertical"

                    android:background="@drawable/edit_text_back"
                    android:text="10"
                    android:textColor="@color/black"

                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="3"

                    android:textStyle="bold"
                    android:paddingHorizontal="6dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="3"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/increaseCases"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:src="@drawable/up_arrow"
                        android:layout_marginHorizontal="3dp"/>

                    <ImageView
                        android:id="@+id/decreaseCases"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:src="@drawable/down_arrow"
                        android:layout_marginHorizontal="3dp"/>

                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"
                android:text="casos"
                android:paddingBottom="2dp"
                android:textAlignment="textEnd"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="40sp"
                android:autoSizeStepGranularity="1sp"

                android:layout_gravity="end|bottom"/>



        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="16dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/darker_transparent_back_border"
            android:padding="12dp"
            android:weightSum="12">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="4"
                android:text="Tempo Máximo:"
                android:textColor="@color/white"
                android:textAlignment="textStart"
                android:textStyle="bold"
                android:maxLines="2"
                android:paddingVertical="4dp"
                android:layout_marginHorizontal="8dp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="60sp"
                android:autoSizeStepGranularity="1sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="6"
                android:orientation="horizontal"
                android:weightSum="10">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/numMinutesET"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="7"
                    android:layout_marginVertical="8dp"

                    android:layout_gravity="center_vertical"

                    android:background="@drawable/edit_text_back"
                    android:text="10"
                    android:textColor="@color/black"

                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="3"

                    android:textStyle="bold"
                    android:paddingHorizontal="6dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="3"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/increaseTime"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:src="@drawable/up_arrow"
                        android:layout_marginHorizontal="3dp"/>

                    <ImageView
                        android:id="@+id/decreaseTime"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:src="@drawable/down_arrow"
                        android:layout_marginHorizontal="3dp"/>

                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"
                android:text="minutos"
                android:paddingBottom="2dp"
                android:textAlignment="textEnd"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="40sp"
                android:autoSizeStepGranularity="1sp"

                android:layout_gravity="end|bottom"/>



        </LinearLayout>




    </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:weightSum="18"
            android:layout_weight="3">

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="2"/>

            <TextView
                android:id="@+id/confirmButton"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginHorizontal="32dp"
                android:layout_weight="15"
                android:autoSizeMaxTextSize="40sp"
                android:autoSizeMinTextSize="12sp"

                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:background="@drawable/green_button"
                android:elevation="10dp"
                android:gravity="center"

                android:paddingTop="20dp"
                android:paddingBottom="27dp"
                android:text="CONFIRMAR"
                android:textColor="@color/white"

                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

        </LinearLayout>

    </LinearLayout>






</LinearLayout>