<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@drawable/back_default"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:weightSum="24"
    tools:context=".SplashActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3">

        <ImageView
            android:id="@+id/returnButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginVertical="6dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/return_button"
            android:padding="12dp"
            android:src="@drawable/return_icon"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintHeight_max="64dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"/>



    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6"
        android:src="@drawable/icdas_icon"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <TextView
        android:id="@+id/text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="40dp"
        android:text="CRIANDO TESTE ..."
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:layout_weight="1"
        android:clipChildren="true"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeMaxTextSize="34sp"
        android:autoSizeStepGranularity="1sp"
        />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3">


        <EditText
            android:id="@+id/nameET"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/edit_text_back"
            android:hint="Insira seu nome (minímo de 4 caracteres)"
            android:textColor="@color/black"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:layout_marginHorizontal="40dp"
            android:layout_marginVertical="12dp"
            android:elevation="5dp"
            android:maxLines="1"
            android:textColorHint="#7A7A7A"


            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHeight_max="60dp"

            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="20sp"
            android:autoSizeStepGranularity="1sp"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:weightSum="3"
        android:orientation="horizontal"
        android:layout_weight="4">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>

        <LinearLayout
            android:id="@+id/buttonStart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/disabled_button"
            android:clickable="false"
            android:layout_margin="4dp"
            android:paddingTop="20dp"
            android:paddingBottom="27dp">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/loading4p"/>

        </LinearLayout>


    </LinearLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2">

    <CheckBox

        android:id="@+id/confirmOnSelectCB"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:button="@color/white"
        android:background="@drawable/checkbox_config"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:textStyle="bold"
        android:textSize="18sp"
        android:paddingHorizontal="12dp"
        android:gravity="center"
        android:textColor="@color/white"

        android:text="Confirmação ao selecionar"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintHeight_max="50dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>



</LinearLayout>