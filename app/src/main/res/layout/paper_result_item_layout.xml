<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="4dp"
    android:paddingBottom="12dp"
    android:paddingHorizontal="18dp"
    android:background="@drawable/paper_card">

    <ImageView
        android:id="@+id/expandIcon"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:src="@drawable/more_icon"
        android:layout_marginTop="8dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"/>

    <TextView
        android:id="@+id/nameTV"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:paddingHorizontal="4dp"
        android:text="Teste"
        android:textAlignment="textStart"
        android:textStyle="bold"
        android:layout_marginStart="2dp"
        android:layout_marginVertical="8dp"
        android:layout_marginEnd="6dp"

        android:gravity="center"

        android:textColor="@color/black"
        android:maxLines="1"
        android:ellipsize="end"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeMaxTextSize="34sp"
        android:autoSizeStepGranularity="1sp"

        android:layout_toStartOf="@id/dateTV"
        android:layout_toEndOf="@id/expandIcon"/>

    <TextView
        android:id="@+id/dateTV"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="18dp"

        android:autoSizeMaxTextSize="34sp"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="00:00 00/00"
        android:gravity="center"

        android:textAlignment="textEnd"
        android:textColor="@color/black"
        android:textStyle="bold" />

    <View
        android:id="@+id/line1"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/black"
        android:layout_marginTop="2dp"
        android:layout_marginHorizontal="6dp"
        android:layout_below="@id/expandIcon"/>

    <RelativeLayout
        android:id="@+id/contentView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_below="@id/line1">

    <LinearLayout
        android:id="@+id/acertosLine"
        android:layout_marginTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="2dp"
        android:weightSum="2"
        android:background="@drawable/gray_back_result">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ACERTOS"
            android:paddingStart="6dp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@drawable/white_back_result"
            android:paddingVertical="4dp"
            android:layout_marginVertical="4dp"
            android:layout_marginStart="4dp"
            android:layout_gravity="center"
            android:maxLines="1"
            android:autoSizeMaxTextSize="34sp"
            android:autoSizeMinTextSize="17sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"/>

        <TextView
            android:id="@+id/acertosTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="100/100"
            android:gravity="end"
            android:layout_marginEnd="8dp"
            android:paddingEnd="8dp"
            android:textColor="#000000"
            android:textSize="18sp"
            android:paddingVertical="4dp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:maxLines="1"
            android:autoSizeMaxTextSize="34sp"
            android:autoSizeMinTextSize="17sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/testTimeLine"
        android:layout_marginTop="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="2dp"
        android:weightSum="2"
        android:background="@drawable/gray_back_result"
        android:layout_below="@+id/acertosLine">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TEMPO DO TESTE"
            android:paddingStart="6dp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@drawable/white_back_result"
            android:paddingVertical="4dp"
            android:layout_marginVertical="4dp"
            android:layout_marginStart="4dp"
            android:layout_gravity="center"
            android:maxLines="1"
            android:autoSizeMaxTextSize="34sp"
            android:autoSizeMinTextSize="17sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"/>

        <TextView
            android:id="@+id/testTimeTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="00:00"
            android:gravity="end"
            android:layout_marginEnd="8dp"
            android:paddingEnd="8dp"
            android:textColor="#000000"
            android:textSize="18sp"
            android:paddingVertical="4dp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:maxLines="1"
            android:autoSizeMaxTextSize="34sp"
            android:autoSizeMinTextSize="17sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/timeLine"
        android:layout_marginTop="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="2dp"
        android:weightSum="2"
        android:background="@drawable/gray_back_result"
        android:layout_below="@+id/testTimeLine">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TEMPO DE CONCLUSÃO"
            android:paddingStart="6dp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:background="@drawable/white_back_result"
            android:paddingVertical="4dp"
            android:layout_marginVertical="4dp"
            android:layout_marginStart="4dp"
            android:layout_gravity="center"
            android:maxLines="1"
            android:autoSizeMaxTextSize="34sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"/>

        <TextView
            android:id="@+id/timeTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="00:00"
            android:gravity="end"
            android:layout_marginEnd="8dp"
            android:paddingEnd="8dp"
            android:textColor="#000000"
            android:textSize="18sp"
            android:paddingVertical="4dp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:maxLines="1"
            android:autoSizeMaxTextSize="34sp"
            android:autoSizeMinTextSize="17sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/taxaAcertoLine"
        android:layout_marginTop="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="2dp"
        android:weightSum="2"
        android:background="@drawable/gray_back_result"
        android:layout_below="@+id/timeLine">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TAXA DE ACERTO"
            android:paddingStart="6dp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:background="@drawable/white_back_result"
            android:paddingVertical="4dp"
            android:layout_marginVertical="4dp"
            android:layout_marginStart="4dp"
            android:layout_gravity="center"
            android:maxLines="1"
            android:autoSizeMaxTextSize="34sp"
            android:autoSizeMinTextSize="17sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"/>

        <TextView
            android:id="@+id/taxaAcertoTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="100%"
            android:gravity="end"
            android:layout_marginEnd="8dp"
            android:paddingEnd="8dp"
            android:textColor="#000000"
            android:textSize="18sp"
            android:paddingVertical="4dp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:maxLines="1"
            android:autoSizeMaxTextSize="34sp"
            android:autoSizeMinTextSize="17sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"/>

    </LinearLayout>

        <TextView
            android:id="@+id/showHistogramBT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ERROS"
            android:drawableStart="@drawable/graph_icon"
            android:textColor="@color/white"
            android:drawablePadding="4dp"
            android:gravity="center"
            android:textSize="18sp"
            android:elevation="1dp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:layout_marginStart="12dp"
            android:padding="12dp"
            android:background="@drawable/histogram_button_unselected"
            android:layout_below="@id/taxaAcertoLine"/>


        <LinearLayout
            android:id="@+id/histogram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone"
            android:translationY="-6dp"
            android:layout_below="@id/showHistogramBT">

            <include android:id="@+id/histogramLayout"
                layout="@layout/histogram_layout"/>
        </LinearLayout>


    </RelativeLayout>




</RelativeLayout>