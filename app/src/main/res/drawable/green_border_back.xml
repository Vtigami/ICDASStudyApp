<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#0A3326"/>
        </shape>
    </item>


    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient android:startColor="#A5FF93"
                android:centerColor="#65FFBD"
                android:endColor="#80F9FF"
                android:angle="180"/>
        </shape>
    </item>



    <item
        android:bottom="3dp"
        android:left="6dp"
        android:right="6dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient android:startColor="#3CE026"
                android:centerColor="#21DE8F"
                android:endColor="#4C87FF"
                android:angle="180"/>
        </shape>
    </item>

    <item
        android:bottom="7dp"
        android:left="10dp"
        android:right="10dp"
        android:top="7dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#BEFFF1"/>
        </shape>
    </item>

    <item
        android:bottom="10dp"
        android:left="13dp"
        android:right="13dp"
        android:top="10dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:startColor="#3CE026"
                android:centerColor="#21DE8F"
                android:endColor="#4C87FF"
                android:angle="180"/>
        </shape>
    </item>








</layer-list>