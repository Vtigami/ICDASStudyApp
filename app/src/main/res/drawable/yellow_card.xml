<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape
            android:shape="rectangle">

            <solid android:color="#373737"/>


            <corners android:radius="18dp" />
        </shape>
    </item>


    <item android:bottom="3dp">
        <shape
            android:shape="rectangle">
        <solid android:color="#565656"/>
         <corners android:radius="18dp" />
        </shape>
    </item>

    <item
        android:bottom="6dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:startColor="#B39E00"
                android:endColor="#FFF096"
                android:angle="90"/>
        </shape>
    </item>


    <item
        android:bottom="11dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#E6D01E"/>
        </shape>
    </item>
</layer-list>