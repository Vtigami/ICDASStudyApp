<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#8472DEFF">

    <!-- Your existing background -->
    <item>
        <layer-list>

            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#646464" />
                    <corners android:radius="450dp" />
                </shape>
            </item>

            <item
                android:bottom="3dp"
                android:left="3dp"
                android:right="3dp"
                android:top="3dp">

                <shape android:shape="rectangle">
                    <solid android:color="#B4B4B4" />
                    <corners android:radius="450dp" />
                </shape>
            </item>

            <item
                android:bottom="6dp"
                android:left="6dp"
                android:right="6dp"
                android:top="6dp">

                <shape android:shape="rectangle">
                    <solid android:color="#F6F6F6" />
                    <corners android:radius="450dp" />
                </shape>
            </item>

        </layer-list>
    </item>

    <!-- Ripple mask -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="45dp" />
        </shape>
    </item>

</ripple>