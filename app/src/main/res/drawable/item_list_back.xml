<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#3A2611"/>
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp"/>
            <gradient android:startColor="#FFD958"
                android:centerColor="#FF9165"
                android:endColor="#FF8E75"
                android:angle="270"/>
        </shape>
    </item>

    <item
        android:bottom="6dp"
        android:left="3dp"
        android:right="3dp"
        android:top="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp"/>
            <gradient android:startColor="#FF7346"
                android:centerColor="#FF8E65"
                android:endColor="#FFC96B"
                android:angle="270"/>
        </shape>
    </item>

    <item
        android:bottom="10dp"
        android:left="7dp"
        android:right="7dp"
        android:top="10dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <stroke android:color="#FFFEE9"
                 android:width="3dp"/>
        </shape>
    </item>




</layer-list>